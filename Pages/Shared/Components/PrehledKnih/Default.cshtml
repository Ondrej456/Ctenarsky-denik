@model PrehledKnihData
@{
}
	@if (Model.KnihyPodleObdobi != null)
	{
			<!-- Maturitní četba -->
			int x = 0;
			@foreach (var obdobi in Model.Obdobi)
			{
				<h2 style="background-color:peachpuff">@obdobi.Nazev</h2>
				
				if (Model.KnihyPodleObdobi.ContainsKey(obdobi.Id))
				{
					int i=0;
					
					<ul>
						@foreach (var kniha in Model.KnihyPodleObdobi[obdobi.Id])
						{
							i++;
							<li>
						<strong><a href="/kniha/@kniha.Id">@kniha.Nazev</a></strong> – @kniha.Autor.Jmeno @kniha.Autor.Prijmeni
							</li>
						}
					</ul>
				x += i;
				<p>Počet knih: @i</p>
				}
				else
				{
					<p>Žádné knihy v tomto období.</p>
				}
			}
	<p><strong>Celkový počet knih: @(x)</strong></p>
	}
	else{
	<table class="table">
		<thead>
			<tr>
				<th>Název</th>
				<th>Rok vydání</th>
				<th>Autor</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var kniha in Model.Knihy ?? Enumerable.Empty<Kniha>())
			{
				<tr>
					<td>
						<a href="/kniha/@kniha.Id">
							@kniha.Nazev
						</a>
					</td>
					<td>@kniha.RokVydani</td>
					<td>@kniha.Autor.Prijmeni @kniha.Autor.Jmeno</td>
				</tr>
			}
		</tbody>
	</table>

	
	}