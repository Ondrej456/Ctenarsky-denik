@page "/knihy/{Pridat?}"
@model Čtenářský_deník.Pages.KnihyModel
@{
	ViewData["Title"] = "Knihy";
}
<h1>Přehled knih</h1>
@if (!string.IsNullOrEmpty(Model.VybranePismeno))
{
	<p><strong>Knihy podle písmena @Model.VybranePismeno</strong></p>
}
@await Component.InvokeAsync("PrehledKnih", new { data = new PrehledKnihData { Knihy = Model.Knihy }, pismeno = Model.VybranePismeno })


