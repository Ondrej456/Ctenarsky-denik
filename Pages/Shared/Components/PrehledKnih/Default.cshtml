@model PrehledKnihData
@{
}
	@if (Model.KnihyPodleObdobi != null)
	{
			<!-- Maturitní četba -->
			int x = 0;
			@foreach (var obdobi in Model.Obdobi)
			{
				<h2 style="background-color:peachpuff">@obdobi.Nazev</h2>
				
				if (Model.KnihyPodleObdobi.ContainsKey(obdobi.Id))
				{
					int i=0;
					
					<ul>
						@foreach (var kniha in Model.KnihyPodleObdobi[obdobi.Id])
						{
							i++;
							<li>
						<strong><a href="/kniha/@kniha.Id">@kniha.Nazev</a></strong> – @kniha.Autor.Jmeno @kniha.Autor.Prijmeni
							</li>
						}
					</ul>
				x += i;
				<p>Počet knih: @i</p>
				}
				else
				{
					<p>Žádné knihy v tomto období.</p>
				}
			}
	<p><strong>Celkový počet knih: @(x)</strong></p>
}
else
{
	@if (Model.AutorId > 0 && (!string.IsNullOrWhiteSpace(Model.Pismeno) || !string.IsNullOrWhiteSpace(Model.Druh)))
	{
		<a href="/autor/@Model.AutorId" onclick="hideFiltryFalse()" class="btn btn-danger" id="abortFiltr" style="margin-bottom:5px;">Zruš filtr</a>
	}
	@if (Model.AutorId == 0 && (!string.IsNullOrWhiteSpace(Model.Pismeno) || !string.IsNullOrWhiteSpace(Model.Druh)))
	{
		<a href="/knihy" onclick="hideFiltryFalse()" class="btn btn-danger" id="abortFiltr">Zruš filtr</a>
	}
	<div style="display:flex;" id="formFiltr">
		<div class="mb-0" >
			<form method="get">
			<label class="form-label">
					<input type="checkbox" id="chkPismeno"> ABC
				</label>
			
				<select id="selectPismeno" name="vybranePismeno" style="display:none";>
					<option value="">Vyber písmeno</option>
				@foreach(var pismeno in PrehledKnihData.Pismena)
				{
					<option value="@pismeno">@pismeno</option>
				}
			</select>
				<button type="submit" onclick="hideFiltryTrue()" id="btnPismeno" style="display:none;"></button>
			</form>
			</div>
		<div class="mb-0" style="margin-left:30px;" >
			<form method="get">
				<label class="form-label">
					<input type="checkbox" id="chkDruh"> Druh
				</label>

				<select id="selectDruh" name="vybranyDruh" style="display:none;">
					<option value="">Vyber literární druh</option>
						@foreach (var druh in PrehledKnihData.Druhy)
						{
							<option value="@druh">@druh</option>
						}
				</select>
				<button type="submit" onclick="hideFiltryTrue()" id="btnDruh" style="display:none;"></button>
			</form>
		</div>	
	</div>

	<table class="table">
		<thead>
			<tr>
				<th>Název</th>
				<th>Literární druh</th>
				<th>Žánr</th>
				<th>Rok vydání</th>
				<th>Autor</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var kniha in Model.Knihy ?? Enumerable.Empty<Kniha>())
			{
				<tr>
					<td>
						<a href="/kniha/@kniha.Id">
							@kniha.Nazev
						</a>
					</td>
					<td>@kniha.Druh</td>
					<td>@kniha.Zanr</td>
					<td>@kniha.RokVydani</td>
					<td>@kniha.Autor.Prijmeni @kniha.Autor.Jmeno</td>
				</tr>
			}
		</tbody>
	</table>

	
	}