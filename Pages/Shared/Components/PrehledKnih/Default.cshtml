@model PrehledKnihData
@{
}
	@if (Model.KnihyPodleObdobi != null)
	{
			<!-- Maturitní četba -->
			int x = 0;
			@foreach (var obdobi in Model.Obdobi)
			{
				<h2 style="background-color:peachpuff">@obdobi.Nazev</h2>
				
				if (Model.KnihyPodleObdobi.ContainsKey(obdobi.Id))
				{
					int i=0;
					
					<ul>
						@foreach (var kniha in Model.KnihyPodleObdobi[obdobi.Id])
						{
							i++;
							<li>
						<strong><a href="/kniha/@kniha.Id">@kniha.Nazev</a></strong> – @kniha.Autor.Jmeno @kniha.Autor.Prijmeni
							</li>
						}
					</ul>
				x += i;
				<p>Počet knih: @i</p>
				}
				else
				{
					<p>Žádné knihy v tomto období.</p>
				}
			}
	<p><strong>Celkový počet knih: @(x)</strong></p>
	}
	else{
		<div class="mb-3">
		<form method="get">
		<label class="form-label">
				<input type="checkbox" id="chkPismeno"> ABC
			</label>
			
			<select id="letterSelect" name="vybranePismeno" style="display:none";>
				<option value="">Vyber písmeno</option>
			@foreach(var pismeno in PrehledKnihData.Pismena)
			{
				<option value="@pismeno">@pismeno</option>
			}
		</select>
			<button type="submit" id="btnFilter">Všechny knihy</button>
		</form>
		</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {

		const checkbox = document.getElementById('chkPismeno');
		const select = document.getElementById('letterSelect');
		const button = document.getElementById('btnFilter');

		if (select.value !== '') {
		checkbox.checked = true;
		select.style.display = 'inline-block';
		}

		checkbox.addEventListener('change', function() {
		select.style.display = this.checked ? 'inline-block' : 'none';
		button.textContent = this.checked? 'Filtrovat' : 'Všechny knihy';

		if (!this.checked) {
		select.value = '';
		}
		});
		});
	</script>
	<table class="table">
		<thead>
			<tr>
				<th>Název</th>
				<th>Rok vydání</th>
				<th>Autor</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var kniha in Model.Knihy ?? Enumerable.Empty<Kniha>())
			{
				<tr>
					<td>
						<a href="/kniha/@kniha.Id">
							@kniha.Nazev
						</a>
					</td>
					<td>@kniha.RokVydani</td>
					<td>@kniha.Autor.Prijmeni @kniha.Autor.Jmeno</td>
				</tr>
			}
		</tbody>
	</table>

	
	}