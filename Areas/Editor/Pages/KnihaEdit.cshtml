@page "/edit/kniha/{IdKnihy:int}"
@model Čtenářský_deník.Areas.Editor.Pages.KnihaEditModel
@{
	ViewData["Title"] = "Editace knihy";
}

@if (Model.Kniha == null)
{
	<p>Kniha nenalezena</p>
	return;
}

<h1>@(Model.IdKnihy == 0 ? "Nová kniha" : "Editace knihy")</h1>
<form method="post" enctype="multipart/form-data">
	<input type="hidden" asp-for="IdKnihy" />
	<input type="hidden" asp-for="AutorId" />
	<input type="hidden" asp-for="Kniha.Id" />

	<div class="form-floating mb-3">

		<input asp-for="Kniha.Nazev" type="text" class="form-control" placeholder="." />
		<label asp-for="Kniha.Nazev"></label>
		
		@if(Model.Chyba != null)
		{
			<div class="alert alert-danger">
				@Model.Chyba
			</div>
		}	

	</div>

	<div class="form-floating mb-3">
		
		<select asp-for="Kniha.Zanr" class="form-select" >
			<option value="">Vyber žánr</option>
			<option value="Sonet">Sonet</option>
			<option value="Óda">Óda</option>
			<option value="Elegie">Elegie</option>
			<option value="Hymnus">Hymnus</option>
			<option value="Balada">Balada</option>
			<option value="Epigram">Epigram</option>
			<option value="Román">Román</option>
			<option value="Povídka">Povídka</option>
			<option value="Epos">Epos</option>
			<option value="Kronika">Kronika</option>
			<option value="Tragédie">Tragédie</option>
			<option value="Komedie">Komedie</option>
			<option value="Bajka">Bajka</option>
			<option value="Melodrama">Melodrama</option>
		</select>
		<label asp-for="Kniha.Zanr" class="form-label"></label>
	</div>
	<div class="form-floating mb-3">
		<input asp-for="Kniha.RokVydani" type="number" class="form-control" placeholder="." />
		<label asp-for="Kniha.RokVydani"></label>
	</div>
	<div class="mb-3">
		<label for="Data_AutorId" class="form-label">Autor</label>
		<select asp-for="Kniha.AutorId" class="form-select" disabled>
			
				<option value="@Model.Autor.Id">@Model.Autor.Prijmeni @Model.Autor.Jmeno</option>
			
		</select>
		<input type="hidden" asp-for="Kniha.AutorId" />
    
	</div>
	<div class="mb-3">
		<label for="Kniha.ObdobiMaturitaId" class="form-label">Maturitní četba</label>
		<select asp-for="Kniha.ObdobiMaturitaId" class="form-select" asp-items="Model.ObdobiSeznam">
			<option value="">Není maturitní četba</option>
		</select>
	</div>
	<div class="form-floating mb-3">
		<textarea asp-for="Kniha.Popis" style="height: 10rem" class="form-control" placeholder="."></textarea>
		<label for="Data_Popis">Popis knihy</label>
	</div>
	@if (Model.Kniha.Images != null)
	{

		<div class="d-flex flex-wrap gap-3 mb-3">
				@foreach (var image in Model.Kniha.Images)
				{
					<div class="mb-3 text-center border rounded p-2 bg-light" style="max-width: 210px;">
						<img src="@image.ImagePath"
							 alt="Foto knihy"
							 class="img-fluid rounded"
							 style="max-width: 200px; height: 150px; object-fit: cover; margin-bottom:10px" />

						<!-- 🌟 Tlačítko upraveno na type="button" - přes JavaScript na dálku odešle skrytý formulář dole -->
					<button type="button"  class="btn btn-sm btn-outline-danger w-100"
								onclick="if (confirm('Opravdu chcete tento obrázek smazat?')) { document.getElementById('formSmazatObrazek_' + @image.Id).submit(); }">
							✕ Smazat
						</button>
					</div>

				}
		</div>
		
	}	
	<div class="mb-3">
		<label for="images" class="form-label">Přidat obrázky</label>
		<input type="file" id="Images" name="Images" multiple class="form-control" />
	</div>
	
	<p>

		
		@if (Model.IdKnihy > 0)
		{
			<button type="submit" class="btn btn-primary">Uložit</button>

			<a href="@(Model.IdKnihy == 0 ? "/knihy" : @$"/kniha/{Model.IdKnihy}")" class="btn btn-outline-primary">Zrušit</a>

			<button type="submit" asp-page-handler="Vymazat" class="btn btn-danger"
					onclick="if (confirm('Opravdu chcete knihu vymazat?')) { document.getElementById('formVymazatKnihu').submit(); }">
				Vymazat
			</button>
		}
		else
		{
			<button type="submit" class="btn btn-primary">Uložit</button>
			<input type="reset" class="btn btn-outline-danger" value="Reset"/>
			<a href="@(Model.IdKnihy == 0 ? "/knihy" : @$"/kniha/{Model.IdKnihy}")" class="btn btn-outline-primary">Zrušit</a>
		}
	</p>
</form>

@if (Model.Kniha.Images != null)
{
	foreach (var image in Model.Kniha.Images)
	{
		<form id="formSmazatObrazek_@image.Id" method="post" asp-page-handler="SmazatObrazek" style="display:none;">
			<input type="hidden" name="idObrazku" value="@image.Id" />
		</form>
	}
}

<!-- 2. Formulář pro smazání celé knihy -->
@if (Model.IdKnihy > 0)
{
	<form id="formVymazatKnihu" method="post" asp-page-handler="Vymazat" style="display:none;">
		<!-- ID se předá automaticky z routy, ale formulář tu musí fyzicky být kvůli CSRF tokenu -->
	</form>
}
