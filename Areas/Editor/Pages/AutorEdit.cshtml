@page "/edit/autor/{IdAutora:Int}"
@model Čtenářský_deník.Areas.Editor.Pages.AutorEditModel
@{
	ViewData["Title"] = "Editace autora";
}

@if(Model.Data == null)
{
	<p>Autor nenalezen</p>
	return;
}

<h1>@(Model.IdAutora == 0 ? "Nový autor" : "Editace autora")</h1>
<form method="post" enctype="multipart/form-data">
	<input type="hidden" asp-for="Data.Id" />
	<div class="form-floating mb-3">
		<input asp-for="Data.Jmeno" type="text" class="form-control" placeholder="." />
		<label asp-for="Data.Jmeno"></label>
	</div>
	<div class="form-floating mb-3">
		<input asp-for="Data.Prijmeni" type="text" class="form-control" placeholder="." />
		<label asp-for="Data.Prijmeni"></label>
	</div>
	@if(Model.Chyba != null)
		{
			<div class="alert alert-danger">
				@Model.Chyba
			</div>
		}	
	<div class="form-floating mb-3">
		<input asp-for="Data.RokNarozeni" type="number" class="form-control" placeholder="." />
		<label asp-for="Data.RokNarozeni"></label>
	</div>
	<div class="form-floating mb-3">
		<input asp-for="Data.RokUmrti" type="number" class="form-control" placeholder="." />
		<label asp-for="Data.RokUmrti"></label>
	</div>

	@if (!string.IsNullOrEmpty(Model.Data.ImagePath))
	{
		<div class="mb-3">
			<img src="@Model.Data.ImagePath"
				 alt="Foto autora"
				 class="img-fluid rounded border"
				 style="max-width: 200px;" />
		</div>
		<div class="mb-3">
			<label for="Image" class="form-label">Změnit obrázek</label>
			<input type="file" id="Image" name="Image" multiple class="form-control" />
		</div>
	}
	else
	{
		<div class="mb-3">
			<label for="Image" class="form-label">Přidat obrázek</label>
			<input type="file" id="Image" name="Image" multiple class="form-control" />
		</div>
	}

	<div class="form-floating mb-3">
		<textarea asp-for="Data.Bio" style="height: 10rem" class="form-control" placeholder="."></textarea>
		<label asp-for="Data.Bio"></label>
	</div>
	<p>
	<button type="submit" class="btn btn-primary">Uložit</button>
	<a href="@(Model.IdAutora == 0 ? "/autori" : @$"/autor/{Model.IdAutora}")" class="btn btn-outline-primary">Zrušit</a>
	@if(Model.IdAutora > 0)
	{
			<button type="submit" asp-page-handler="Vymazat" class="btn btn-danger"
					onclick="return confirm('Opravdu chcete autora vymazat?');">
				Vymazat
			</button>
	}	
	</p>
</form>





