@page
@model Čtenářský_deník.Pages.M_MaturitniCetbaModel
@{
	ViewData["Title"] = "Maturitní Četba";
}
<h1 style="text-align:center; background-color:blanchedalmond">Maturitní Četba</h1>

@foreach (var obdobi in Model.Obdobi)
{
    <h2 class="maturitniCetba">@obdobi.Nazev</h2>

    @if (Model.KnihyPodleObdobi.ContainsKey(obdobi.Id))
    {
        @await Component.InvokeAsync("PrehledKnih", new { 
            data = new PrehledKnihData { 
                Knihy = Model.KnihyPodleObdobi[obdobi.Id] 
            } 
        })
    }
    else
    {
        <p>Žádné knihy v tomto období.</p>
    }
}