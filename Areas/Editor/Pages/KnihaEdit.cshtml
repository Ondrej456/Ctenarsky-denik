@page "/edit/kniha/{IdKnihy:int}"
@model Čtenářský_deník.Areas.Editor.Pages.KnihaEditModel
@{
	ViewData["Title"] = "Editace knihy";
}

@if (Model.Data == null)
{
	<p>Kniha nenalezena</p>
	return;
}

<h1>@(Model.IdKnihy == 0 ? "Nová kniha" : "Editace knihy")</h1>
<form method="post" enctype="multipart/form-data">
	<input type="hidden" asp-for="Data.Id" />
	<div class="form-floating mb-3">
		<input asp-for="Data.Nazev" type="text" class="form-control" placeholder="." />
		<label asp-for="Data.Nazev"></label>
		@if(Model.Chyba != null)
		{
			<div class="alert alert-danger">
				@Model.Chyba
			</div>
		}	
	</div>
	<div class="form-floating mb-3">
		<input asp-for="Data.RokVydani" type="number" class="form-control" placeholder="." />
		<label asp-for="Data.RokVydani"></label>
	</div>
	<div class="mb-3">
		<label for="Data_AutorId" class="form-label">Autor</label>
		<select asp-for="Data.AutorId" class="form-select" disabled>
			
				<option value="@Model.Autor.Id">@Model.Autor.Prijmeni @Model.Autor.Jmeno</option>
			
		</select>
		<input type="hidden" asp-for="Data.AutorId" />
    
	</div>
	<div class="mb-3">
		<label for="Data.ObdobiMaturitaId" class="form-label">Maturitní četba</label>
		<select asp-for="Data.ObdobiMaturitaId" class="form-select" asp-items="Model.ObdobiSeznam">
			<option value="">Není maturitní četba</option>
		</select>
	</div>
	<div class="form-floating mb-3">
		<textarea asp-for="Data.Popis" style="height: 10rem" class="form-control" placeholder="."></textarea>
		<label for="Data_Popis">Popis knihy</label>
	</div>
	<div class="mb-3">
		<label for="images" class="form-label">Přidat obrázky</label>
		<input type="file" id="Images" name="Images" multiple class="form-control" />
	</div>
	<p>
		<button type="submit" class="btn btn-primary">Uložit</button>
		<a href="@(Model.IdKnihy == 0 ? "/knihy" : @$"/kniha/{Model.IdKnihy}")" class="btn btn-outline-primary">Zrušit</a>
		@if (Model.IdKnihy > 0)
		{
			<button type="submit" asp-page-handler="Vymazat" class="btn btn-danger"
					onclick="return confirm('Opravdu chcete autora vymazat?');">
				Vymazat
			</button>
		}
	</p>
</form>


