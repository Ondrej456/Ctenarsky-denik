@page "/autor/{Id:int}"
@model Čtenářský_deník.Pages.AutorDetailModel
@{
	ViewData["Title"] = Model.Autor?.Prijmeni;
}
@if (Model.Autor == null)
{
	<p>Autor nenalezen</p>
	return;
}
<h1>@Model.Autor.Jmeno @Model.Autor.Prijmeni</h1>

@if (!string.IsNullOrEmpty(Model.Autor.ImagePath))
{
	<div class="mb-3">
		<img src="@Model.Autor.ImagePath"
			 alt="Foto autora"
			 class="img-fluid rounded border"
			 style="float:left; margin-right:10px; max-width: 250px;" />
	</div>
}
else
{
	<p class="text-muted">Autor nemá nahranou fotku.</p>
}

<div style="white-space:pre-line; font-weight:bolder; font-family: Consolas, Courier New, monospace;">
	Narozen(a) @(Model.Autor.RokNarozeni +
		(Model.Autor.RokUmrti == null ? "" : ", zemřel(a) " + Model.Autor.RokUmrti))

	@Model.Autor.Bio
</div>

<div style="clear:left;">
<br>
	@if (!string.IsNullOrEmpty(Model.VybranePismeno))
	{
		<p><strong>Knihy podle písmena @Model.VybranePismeno</strong></p>
	}
	@if (!string.IsNullOrEmpty(Model.VybranyDruh))
	{
		<p><strong>Knihy podle literárního druhu: @Model.VybranyDruh</strong></p>
	}

	@await Component.InvokeAsync("PrehledKnih", new { data = new PrehledKnihData { Knihy = Model.Autor.Knihy, AutorId = Model.Autor.Id, Pismeno = Model.VybranePismeno, Druh = Model.VybranyDruh }, pismeno = Model.VybranePismeno, druh = Model.VybranyDruh })
</div>
<p>
	<a href="/edit/kniha/0?autorId=@Model.Autor.Id") class="btn btn-primary">Přidat knihu</a> <!-- ?autorId - Id pro daného autora-->
</p>
<p>
	<a href="/edit/autor/@Model.Autor.Id" class="btn btn-outline-primary">Upravit autora</a>
	<a href="/Autori" class="btn btn-outline-primary">Seznam autorů</a>
	<a href="/knihy" class="btn btn-outline-primary">Seznam knih</a>

</p>